# Install with: crontab ~/server-tools/crontab     (times are UTC)
PATH=/home/cosmic/bin:/usr/local/bin:/usr/bin:/bin
TOOLS=/home/cosmic/server-tools

# Start the live server when the machine boots. lifesteal1 is retired and stays off.
@reboot sleep 30 && $TOOLS/mc lifesteal2 start

# Local AI model used by the in-game /ai admin (ai_admin_bridge.py).
@reboot tmux new-session -d -s ollama "OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS=/home/cosmic/ollama/models /home/cosmic/ollama/bin/ollama serve 2>&1 | tee -a /home/cosmic/ollama/serve.log"

# Daily backup at 05:00; "daily" backups older than 14 days are deleted automatically.
0 5 * * * $TOOLS/backup.sh lifesteal2 daily >> /home/cosmic/backups/backup.log 2>&1

# Reset the Nether and End every 3 months (1 Jan, 1 Apr, 1 Jul, 1 Oct).
# Players get a 30 minute countdown starting at 05:30; the reset happens at 06:00.
30 5 1 1,4,7,10 * $TOOLS/reset-dimensions.sh lifesteal2 1800 >> /home/cosmic/backups/reset.log 2>&1
